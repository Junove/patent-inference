{
  "name": "patent-inference",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "frontend",
    "packages/shared",
    "packages/contracts"
  ],
  "scripts": {
    "setup": "npm ci",
    "dev": "npm run dev --workspace @near-private-ai/frontend",
